# Run node scripts/setup-selfhost.mjs owner@example.com to generate secrets.
GROBLIN_VERSION=0.1.0
PUBLIC_URL=https://cms.example.com
STORAGE_PUBLIC_URL=https://media.example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
BETTER_AUTH_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
MEDIA_SIGNING_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_64_HEX_CHARACTERS
AWS_REGION=us-east-1
AWS_BUCKET=groblin-media
AWS_ACCESS_KEY_ID=REPLACE_WITH_RANDOM_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_WITH_RANDOM_SECRET_KEY
EMAIL_TRANSPORT=smtp
SMTP_URL=smtps://username:password@smtp.example.com:465
EMAIL=no-reply@example.com
REGISTRATION_MODE=invite
BOOTSTRAP_EMAIL=owner@example.com
HISTORY_DAYS=30
HISTORY_LIMIT=1000
PUBLICATION_LIMIT=100
