{
	"name": "backend",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"types:db": "kysely-codegen --out-file src/database/schema.ts --dialect postgres",
		"types:db:isolated": "tsx scripts/generate-db-types.ts",
		"schema:db": "./dump_db.sh",
		"schema": "pnpm types:db",
		"server": "tsx watch --include ./src --include ../shared/src src/server.ts",
		"schema:test": "UPDATE_TEST_SCHEMA=1 vitest run src/services/public-server.test.ts && graphql-codegen --config tests/codegen.ts",
		"test": "vitest",
		"schema:api": "graphql-codegen --config codegen.ts",
		"schema:db:build": "tsx scripts/build-database-schema.ts",
		"db:migrate": "tsx scripts/migrate.ts",
		"start": "tsx src/server.ts"
	},
	"devDependencies": {
		"@testcontainers/postgresql": "12.2.0",
		"@types/chroma-js": "3.1.2",
		"@types/ms": "2.1.0",
		"@types/node": "26.6.3",
		"@types/nodemailer": "^8.0.2",
		"@types/pg": "8.23.1",
		"@types/ws": "8.18.2",
		"aws-sdk-client-mock": "4.1.0",
		"cross-env": "10.1.0",
		"graphql-tag": "2.12.7",
		"kysely-codegen": "0.20.0",
		"testcontainers": "12.2.0",
		"vitest": "5.0.3"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1143.0",
		"@aws-sdk/client-ses": "3.1143.0",
		"@aws-sdk/s3-request-presigner": "3.1143.0",
		"ansicolor": "2.0.3",
		"better-auth": "1.7.6",
		"chroma-js": "3.2.0",
		"date-fns": "4.4.0",
		"graphql-scalars": "2.0.0",
		"graphql-yoga": "5.24.1",
		"inversify": "8.2.3",
		"kysely": "0.29.6",
		"matchblade": "0.1.1",
		"ms": "2.1.3",
		"nodemailer": "^10.0.13",
		"pg": "8.23.1",
		"purify-ts": "2.1.4",
		"reflect-metadata": "0.2.2",
		"sharp": "0.35.5",
		"uuid": "14.0.2",
		"ws": "8.22.0",
		"zod": "4.6.5"
	},
	"license": "MIT"
}
