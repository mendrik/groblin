{
	"$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/*.ts",
			"**/*.tsx",
			"**/*.js",
			"**/*.jsx",
			"!**/gen/**/*",
			"!**/schema.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"security": {
				"noDangerouslySetInnerHtml": "off"
			},
			"a11y": {
				"noLabelWithoutControl": "off"
			},
			"preset": "recommended",
			"complexity": {
				"noForEach": "off",
				"useArrowFunction": "error",
				"noBannedTypes": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noAssignInExpressions": "off",
				"noPrototypeBuiltins": "off"
			},
			"correctness": {
				"noUnusedImports": "error",
				"noChildrenProp": "off",
				"noUnsafeOptionalChaining": "off"
			},
			"performance": {
				"noAccumulatingSpread": "off"
			},
			"style": {
				"noUselessElse": "off",
				"noUnusedTemplateLiteral": "off",
				"noNonNullAssertion": "off",
				"useImportType": {
					"fix": "safe",
					"level": "error"
				}
			}
		}
	},
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		},
		"formatter": {
			"quoteStyle": "single",
			"semicolons": "asNeeded",
			"trailingCommas": "none",
			"arrowParentheses": "asNeeded"
		}
	}
}
